import funkin.modding.module.Module;
import funkin.play.PlayState;

class DiscordRPCCompat extends Module {
    function new() {
        super("DiscordRPCCompat", 1);
    }

    var compatbileMods:Array<String> = [
        "Waterworks", "sussus-snowgus", "Daizy", "Binge", "Sip", "Blissful", "Obliterated", "Redeemer", "Mortality", "CHAMB3R", "High School Conflict", "Bara no Yume", "Your Demise",
        "Your Reality (Takeover Mix)", "Rain Clouds", "My Confession", "My Sweets", "Baka", "Deep Breaths", "Obsession", "You and Me", "Dokidoggle", "Poems n Thorns", "Epiphany",
        "Drinks on Me", "Catfight", "Wilted", "MSTSOOBF", "Headache", "Nerves", "Release", "Headache (OG)", "Nerves (OG)", "Release (OG)", "Snake-Eyes", "Technicolor-Tussle",
        "Knockout", "Whoopee", "Sansational", "Burning-In-Hell", "Final-Stretch", "Imminent-Demise", "Terrible-Sin", "Last-Reel", "Nightmare-Run", "Satanic-Funkin", "Bad-To-The-Bone",
        "Bonedoggle", "Ritual", "Freaky-Machine"
    ] ;

    var albumOnlyMods:Array<String> = [
        "(Gooey Mix)"
    ] ;

    override function onSongLoaded(event:SongLoadScriptEvent) {
        if (PlayState.instance == null) return;
        var songName:String = PlayState.instance.currentChart.songName;
        if (albumOnlyMods.indexOf(songName) != -1) {
            PlayState.instance.discordRPCAlbum = "https://github.com/Starexify/DiscordRPCCompat/blob/assets/album-covers/" + PlayState.instance.currentChart.album + ".png?raw=true";
        }
        if (compatbileMods.indexOf(songName) != -1) {
            PlayState.instance.discordRPCAlbum = "https://github.com/Starexify/DiscordRPCCompat/blob/assets/album-covers/" + PlayState.instance.currentChart.album + ".png?raw=true";
            PlayState.instance.discordRPCIcon = "https://github.com/Starexify/DiscordRPCCompat/blob/assets/icons/" + PlayState.instance.currentChart.characters.opponent + ".png?raw=true";
        }
    }
}