import funkin.modding.module.Module;
import funkin.api.discord.DiscordClient;
import funkin.play.PauseSubState;
import funkin.play.PlayState;

class DiscordRPCCompat extends Module {
    function new() {
        super("DiscordRPCCompat", 1);
    }

    var compatbileMods:Array<String> = [
        "Waterworks", "sussus-snowgus", "Daizy", "Binge", "Sip", "Blissful", "Obliterated", "Redeemer", "Mortality", "CHAMB3R"
    ] ;

    override function onSongLoaded(event:SongLoadScriptEvent) {
        if (PlayState.instance == null) return;
        if (compatbileMods.indexOf(PlayState.instance.currentChart.songName) == -1) return;
        PlayState.instance.discordRPCAlbum = "https://github.com/Starexify/DiscordRPCCompat/blob/assets/album-covers/" + PlayState.instance.currentChart.album + ".png?raw=true";
        PlayState.instance.discordRPCIcon = "https://github.com/Starexify/DiscordRPCCompat/blob/assets/icons/" + PlayState.instance.currentChart.characters.opponent + ".png?raw=true";
    }
}