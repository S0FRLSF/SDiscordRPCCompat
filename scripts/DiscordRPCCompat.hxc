import funkin.modding.module.Module;
import funkin.play.PlayState;

import openfl.net.URLLoader;
import openfl.net.URLRequest;

import Date;
import StringTools;

class DiscordRPCCompat extends Module {
    function new() {
        super("DiscordRPCCompat", 1);
    }

    override function onSongLoaded(event:SongLoadScriptEvent) {
        if (PlayState.instance == null) return;
        var songName = PlayState.instance.currentChart.songName;
        var timeStamp = Date.now().getTime();

        var albumLoader:URLLoader = new URLLoader();
        albumLoader.addEventListener("complete", event -> {
            var rawData:String = albumLoader.data;
            var albumOnlyMods:Array<String> = rawData.split(",").map(item -> return StringTools.trim(item));
            for (suffix in albumOnlyMods) if (songName.indexOf(suffix) != -1) PlayState.instance.discordRPCAlbum = "https://github.com/Starexify/DiscordRPCCompat/blob/assets/album-covers/" + PlayState.instance.currentChart.album + ".png?raw=true?t=" + timeStamp;
        });
        albumLoader.load(new URLRequest("https://raw.githubusercontent.com/Starexify/DiscordRPCCompat/refs/heads/assets/AlbumOnlyMods.txt?t=" + timeStamp));

        var loader:URLLoader = new URLLoader();
        loader.addEventListener("complete", event -> {
            var rawData:String = loader.data;
            var compatbileMods:Array<String> = rawData.split(",").map(item -> return StringTools.trim(item));
            if (compatbileMods.indexOf(songName) != -1) {
                PlayState.instance.discordRPCAlbum = "https://github.com/Starexify/DiscordRPCCompat/blob/assets/album-covers/" + PlayState.instance.currentChart.album + ".png?raw=true?t=" + timeStamp;
                PlayState.instance.discordRPCIcon = "https://github.com/Starexify/DiscordRPCCompat/blob/assets/icons/" + PlayState.instance.currentChart.characters.opponent + ".png?raw=true?t=" + timeStamp;
            }
        });
        loader.load(new URLRequest("https://raw.githubusercontent.com/Starexify/DiscordRPCCompat/refs/heads/assets/CompatSongList.txt?t=" + timeStamp));
    }
}
