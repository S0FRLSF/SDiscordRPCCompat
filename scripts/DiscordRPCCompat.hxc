import funkin.modding.module.Module;
import funkin.api.discord.DiscordClient;
import funkin.play.PauseSubState;
import funkin.play.PlayState;

class DiscordRPCCompat extends Module {
    function new() {
        super("DiscordRPCCompat", 1);
    }

    var compatbileMods:Array<String> = [
        // Hazlenuts
        "Waterworks",
        // sussus-snowgus
        "sussus-snowgus",
        // IRN BRU
        "Daizy", "Binge", "Sip"
    ] ;

    override function onSongLoaded(event:SongLoadScriptEvent) {
        if (compatbileMods.indexOf(state.currentChart.songName) == -1) return;
        PlayState.instance.discordRPCAlbum = "https://github.com/Starexify/DiscordRPCCompat/blob/assets/album-covers/" + state.currentChart.album + ".png?raw=true";
        PlayState.instance.discordRPCIcon = "https://github.com/Starexify/DiscordRPCCompat/blob/assets/icons/" + state.currentChart.characters.opponent + ".png?raw=true";
    }
}